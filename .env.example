# Required Supabase browser configuration. Use a publishable key, never a secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key

# Optional legacy key name, only if your project has not moved to publishable keys.
# VITE_SUPABASE_ANON_KEY=your_legacy_anon_key

# Optional: prefill the Base URL field shown in Settings for remote data sources.
VITE_DEFAULT_API_BASE_URL=https://api.example.com
