# Supabase connection (use the publishable key; never expose a service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this name instead:
# VITE_SUPABASE_ANON_KEY=

# Optional: prefill the Base URL field shown in Settings for remote data sources.
VITE_DEFAULT_API_BASE_URL=
